+void AASession::postByeBye() {
+    if (wake_pipe_[1] < 0) { printf("[AASession] ByeByeRequest not sent (no wake pipe)\n"); return; }
+    pthread_mutex_lock(&touch_mutex_);
+    pending_bye_ = true;
+    pthread_mutex_unlock(&touch_mutex_);
+    char b = 1;
+    ssize_t w = write(wake_pipe_[1], &b, 1);
+    (void)w;
+}
