     }
+    if (bye) {
+        bool ok = false;
+        if (cryptor_.isHandshakeComplete()) {
+            const uint8_t req[4] = { 0x00, 0x0F, 0x08, 0x01 };     // ByeByeRequest {reason = 1 USER_SELECTION}
+            std::vector<uint8_t> enc;
+            ok = cryptor_.encrypt(req, sizeof(req), enc) && sendFrame(0x00, 0x0B, &enc[0], enc.size());
+        }
+        printf("[AASession] ByeByeRequest -> phone: %s\n", ok ? "sent" : "not sent (no encrypted session)");
+    }
     if (night && !sendSensorEvent(10)) printf("[AASession] NIGHT_MODE event: SEND FAILED\n");
     if (focus) {
         bool ok = sendVideoFocusIndication(6, focus == 1, true);
@@ -1373,6 +1396,9 @@ void AASession::sessionLoop() {
                            reason == 0xFFFFFFFFu ? -1 : (int)reason, reason == 1 ? " = quit" : "",
