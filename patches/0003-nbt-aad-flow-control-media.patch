+// ---- Paced video acks (NBT car 2026-11-12, see aa_session.hpp) --------------------------------------------------------
+
+void AASession::pumpVideoAcks() {
+    while (video_ack_pending_ && (video_fps_ || video_gate_)) {
+        if (video_gate_) {
+            // one credit per frame the consumer has passed on (postVideoConsumed); never more credits than frames waiting
+            const unsigned granted = video_granted_;
+            if (granted - video_used_ > video_ack_pending_) video_used_ = granted - video_ack_pending_;
+            if (granted == video_used_) {
+                // Safety net: the consumer has reported nothing for 15 s (longer than any decoder restart). Ack what
+                // is waiting so a lost report can never freeze the video for good.
+                const double t = monoS();
+                if (video_gate_wait_s_ == 0) video_gate_wait_s_ = t;
+                if (t - video_gate_wait_s_ < 15.0) return;
+                printf("[AASession] video gate: no report from the consumer for 15 s, acking %u frame(s) anyway\n",
+                       video_ack_pending_);
+                while (video_ack_pending_) {
+                    sendAvMediaAck(6);
+                    --video_ack_pending_;
+                }
+                video_gate_wait_s_ = 0;
+                return;
+            }
+            video_gate_wait_s_ = 0;
+        }
+        const double now = monoS();
+        if (video_fps_ && now < video_ack_next_s_) return;
+        sendAvMediaAck(6);
+        --video_ack_pending_;
+        if (video_gate_) ++video_used_;
+        if (!video_fps_) continue;
+        const double period = 1.0 / video_fps_;
+        // on schedule: next slot one period after this one (keeps the average when a tick came late);
+        // after a pause no credit is saved up
+        video_ack_next_s_ = (video_ack_next_s_ + period > now) ? video_ack_next_s_ + period : now + period;
+        return;
+    }
+}
+
+void AASession::setVideoAckGate(bool on) {
+    video_gate_ = on;
+}
+
+void AASession::postVideoConsumed(unsigned frames, bool wake) {
+    if (!frames) return;
+    __sync_fetch_and_add(&video_granted_, frames);
+    if (wake) wakeSessionThread();
+}
+
+void AASession::setMediaStatusCallback(MediaStatusCallback cb, void* user_data) {
+    media_cb_ = cb;
+    media_user_data_ = user_data;
+}
+
+uint32_t AASession::videoTickMs() const {
+    if (!video_ack_pending_) return 1000u;
+    // waiting for the consumer: postVideoConsumed() wakes the thread, the short tick is only a fallback
+    if (video_gate_ && video_granted_ == video_used_) return 20u;
+    if (!video_fps_) return 1u;
+    const double wait = video_ack_next_s_ - monoS();
+    if (wait <= 0.001) return 1u;
+    if (wait >= 1.0) return 1000u;
+    return (uint32_t)(wait * 1000.0) + 1u;
+}
