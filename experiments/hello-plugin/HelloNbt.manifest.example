<?xml version="1.0" encoding="UTF-8"?>
<!-- Deliberately an example: connector ID and loading path need validation. -->
<plugin>
  <name>HelloNbt</name>
  <type>App</type>
  <file>{pluginDir}/libHelloNbt.so</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies>
      <pluginAppConnector>
        <type>Etch</type>
        <id>211</id>
        <asyncCallbacks>yes</asyncCallbacks>
      </pluginAppConnector>
    </dependencies>
    <parameters>
      <DescFile>{pluginDir}/HelloNbt.xml</DescFile>
      <TextDBFile>{pluginDir}/HelloNbt_ALL_Texts.zip</TextDBFile>
      <ImageDBFile>{pluginDir}/HelloNbt_ALL_Images.zip</ImageDBFile>
    </parameters>
  </config>
</plugin>
