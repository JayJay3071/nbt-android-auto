<?xml version="1.0" encoding="UTF-8"?>
<!-- Same connector and layout as the vehicle-installed NbtLiveImage manifest. -->
<plugin>
  <name>NbtAndroidAuto</name>
  <type>App</type>
  <file>{pluginDir}/libNbtAndroidAuto.so</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies>
      <pluginAppConnector>
        <type>Etch</type>
        <id>211</id>
        <asyncCallbacks>yes</asyncCallbacks>
      </pluginAppConnector>
    </dependencies>
    <parameters>
      <DescFile>{pluginDir}/NbtAndroidAuto.xml</DescFile>
      <TextDBFile>{pluginDir}/NbtAndroidAuto_ALL_Texts.zip</TextDBFile>
      <ImageDBFile>{pluginDir}/NbtAndroidAuto_ALL_Images.zip</ImageDBFile>
    </parameters>
  </config>
</plugin>
