      <textIdModel id="22" textId="15" preinst="false"/>
      <textIdModel id="23" textId="18" preinst="false"/>
      <textIdModel id="24" textId="10" preinst="false"/>
      <textIdModel id="25" textId="19" preinst="false"/>
      <!-- 70, not 26: id 26 is the 16:9 button's action; with a model of the same id the 16:9 button did nothing (car
           2026-11-12: only "mode page widescreen" ever reached the plugin) -->
      <textIdModel id="70" textId="20" preinst="false"/>
      <textIdModel id="82" textId="21" preinst="false"/>
      <textIdModel id="83" textId="22" preinst="false"/>
      <textIdModel id="84" textId="23" preinst="false"/>
      <textIdModel id="85" textId="24" preinst="false"/>
      <textIdModel id="91" textId="31" preinst="false"/>
      <textIdModel id="94" textId="33" preinst="false"/>
      <textIdModel id="95" textId="34" preinst="false"/>
    </models>
    <events>
      <focusEvent id="52" target="13"/>
      <focusEvent id="53" target="10"/>
      <!-- second way into the hold states (car 2026-11-09: iDrive ignored 52 after the page had been left from level 18;
           the plugin alternates 52 / 54 while one is ignored) -->
      <focusEvent id="54" target="13"/>
      <!-- 200..299: the pool the plugin uses (car 2026-11-18, HmiMain3D CFocusEvent::perform): iDrive performs each
           focus event at most 11 times per HMI start ("[RHMI FocusEvent] FocusEvent counter > 10", the counter lives
           in the event and is never reset; only apps with the permission rhmi.unlimitedfocusevents are exempt). The
           plugin uses each event 10 times, then the next one. -->
